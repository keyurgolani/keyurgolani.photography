{
  "name": "myapp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest",
    "test:e2e": "playwright test",
    "smoke:media": "bash ci/smoke-media.sh",
    "lint": "eslint .",
    "images:watch": "npx tsx scripts/imageWatcher.ts --watch",
    "images:process": "npx tsx scripts/imageWatcher.ts --once",
    "images:optimize": "npm run images:process --",
    "images:cleanup": "npx tsx scripts/imageCleanup.ts",
    "photos:migrate": "npx tsx scripts/photos.ts migrate",
    "photos:identity": "npx tsx scripts/photos.ts identity"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "exif-reader": "^2.0.3",
    "framer-motion": "^12.27.1",
    "lucide-react": "^0.441.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/exif-reader": "^1.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
