# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Host settings for docker-compose.prod.yml, such as PHOTOGRAPHY_IMAGE_TAG,
# and every other env file Next might load
.env*
*.env
!.env.example

# Secret files for docker-compose.prod.yml, never committed
secrets/

# Next.js
.next*/
out/
build/
next-env.d.ts
.vercel/
.turbo/
.vitest/
coverage/

# Playwright
test-results/
playwright-report/
blob-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Photo assets - ignore images but keep directory structure
public/assets/photos/*
!public/assets/photos/.gitkeep
!public/assets/photos/README.md

# Generated image variants (thumbnails/optimized)
public/assets/photos/thumbnails/
public/assets/photos/optimized/

# TypeScript build info
*.tsbuildinfo

# Temporary SDLC / planning artifacts
.superpowers/
# The Impeccable design hook's session cache: session IDs and local paths
.impeccable/
docs/plans/
docs/specs/
OPTIMIZATION_PLAN*
task_plan.md
findings.md
progress.md

# Private identity state, the default data root outside production
/portfolio-data/

# The site config folder: About's portrait and its portrait.json live on the
# host, beside docker-compose.prod.yml, never in the repository
/site-config/
